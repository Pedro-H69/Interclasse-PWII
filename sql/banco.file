CREATE DATABASE IF NOT EXISTS interclasse CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE interclasse;

CREATE TABLE modalidades (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,
    min_jogadores INT NOT NULL,
    max_jogadores INT NOT NULL
);

INSERT INTO modalidades (nome, min_jogadores, max_jogadores) VALUES 
('Volei', 6, 10),    
('Basquete', 3, 5); 

CREATE TABLE turmas (
    id INT AUTO_INCREMENT PRIMARY KEY,
    serie ENUM('1-MTec', '2-MTec', '3-MTec', "Tec") NOT NULL
    curso ENUM('DS', 'ADM', 'RH', "CONT") NOT NULL
    turno ENUM('Manha', 'tarde', 'noite') NOT NULL
);

CREATE TABLE times (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(80) NOT NULL,
    turma_id INT NOT NULL,
    FOREIGN KEY (turma_id) REFERENCES turmas(id) ON DELETE CASCADE
);

CREATE TABLE jogadores (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    time_id INT NOT NULL,
    FOREIGN KEY (time_id) REFERENCES times(id) ON DELETE CASCADE
);

CREATE TABLE inscricoes (
    id INT AUTO_INCREMENT PRIMARY KEY,
    time_id INT NOT NULL,
    modalidade_id INT NOT NULL,
    status ENUM('pendente', 'aprovada', 'recusada') NOT NULL DEFAULT 'pendente',
    FOREIGN KEY (time_id) REFERENCES times(id) ON DELETE CASCADE,
    FOREIGN KEY (modalidade_id) REFERENCES modalidades(id) ON DELETE CASCADE,
    UNIQUE KEY unique_time_mod (time_id, modalidade_id)
);